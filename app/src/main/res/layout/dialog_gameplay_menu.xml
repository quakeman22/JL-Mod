<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="248dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gameplay_menu_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/gameplay_menu_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:text="@string/cmd_menu"
        android:textColor="@color/settings_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gameplay_menu_exit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gameplay_menu_row"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="38dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:text="@string/exit"
        android:textColor="@color/settings_title"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/gameplay_menu_save_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_gameplay_menu_row"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="38dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:text="@string/save_log"
        android:textColor="@color/settings_title"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/gameplay_menu_lock_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_gameplay_menu_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_lock_orientation"
            android:textColor="@color/settings_title"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/gameplay_menu_lock_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/settings_toolbar_end"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/gameplay_menu_ime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_gameplay_menu_row"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="38dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:text="@string/action_keyboard_ime"
        android:textColor="@color/settings_title"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/gameplay_menu_screenshot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_gameplay_menu_row"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="38dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:text="@string/take_screenshot"
        android:textColor="@color/settings_title"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/gameplay_menu_limit_fps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_gameplay_menu_row"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="38dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:text="@string/PREF_LIMIT_FPS"
        android:textColor="@color/settings_title"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/gameplay_menu_multiplayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.55"
        android:background="@drawable/bg_gameplay_menu_row"
        android:enabled="false"
        android:minHeight="38dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="7dp"
        android:text="@string/action_multiplayer"
        android:textColor="@color/settings_title"
        android:textSize="16sp" />

</LinearLayout>
