<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/midletFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_apps_launcher"
    tools:context="javax.microedition.shell.MicroActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/virtual_display"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_controls_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.72" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_controls_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.96" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            android:descendantFocusability="blocksDescendants"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:popupTheme="@style/AppTheme.NoActionBar"
            tools:title="MIDlet Title" />

        <ImageButton
            android:id="@+id/button_back_overlay"
            style="@style/ImageButtonStyle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_launcher_play_button"
            android:contentDescription="@string/exit"
            android:padding="11dp"
            android:src="@drawable/ic_launcher_arrow_left"
            android:tint="@android:color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/game_frame"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_micro_display_frame"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:padding="14dp"
            app:layout_constraintBottom_toTopOf="@+id/control_top_row"
            app:layout_constraintDimensionRatio="3:4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintVertical_bias="0.02"
            app:layout_constraintWidth_default="percent"
            app:layout_constraintWidth_max="360dp"
            app:layout_constraintWidth_percent="0.76">

            <FrameLayout
                android:id="@+id/game_surface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF000000"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:padding="2dp">

                <FrameLayout
                    android:id="@+id/displayable_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp"
                    android:background="#FF000000"
                    android:clipChildren="true"
                    android:clipToPadding="true" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/control_top_row"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/game_frame"
            app:layout_constraintStart_toStartOf="@id/game_frame"
            app:layout_constraintTop_toBottomOf="@id/game_frame">

            <TextView
                android:id="@+id/button_soft_left_shell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_micro_control_bar"
                android:gravity="center"
                android:text="L"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/button_menu_shell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_micro_control_bar"
                android:gravity="center"
                android:text="II"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/button_soft_right_shell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_micro_control_bar"
                android:gravity="center"
                android:text="R"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/control_pad_shell"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_micro_pad_shell"
            app:layout_constraintBottom_toBottomOf="@id/guide_controls_bottom"
            app:layout_constraintDimensionRatio="1.08:1"
            app:layout_constraintEnd_toStartOf="@id/action_cluster"
            app:layout_constraintHorizontal_bias="0.18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/guide_controls_top"
            app:layout_constraintWidth_default="percent"
            app:layout_constraintWidth_max="250dp"
            app:layout_constraintWidth_percent="0.41">

            <View
                android:layout_width="72dp"
                android:layout_height="144dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_micro_dpad_button" />

            <View
                android:layout_width="144dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_micro_dpad_button" />
        </FrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/action_cluster"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="@id/guide_controls_bottom"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/control_pad_shell"
            app:layout_constraintTop_toTopOf="@id/guide_controls_top"
            app:layout_constraintWidth_default="percent"
            app:layout_constraintWidth_min="188dp"
            app:layout_constraintWidth_max="206dp"
            app:layout_constraintWidth_percent="0.34">

            <TextView
                android:id="@+id/button_y_shell"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/bg_micro_action_button"
                android:gravity="center"
                android:text="Y"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/button_b_shell"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/bg_micro_action_button"
                android:gravity="center"
                android:text="B"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5" />

            <TextView
                android:id="@+id/button_x_shell"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/bg_micro_action_button"
                android:gravity="center"
                android:text="X"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.5" />

            <TextView
                android:id="@+id/button_a_shell"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/bg_micro_action_button"
                android:gravity="center"
                android:text="A"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <javax.microedition.lcdui.overlay.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
