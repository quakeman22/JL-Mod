<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="248dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gameplay_menu_panel"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/gameplay_confirm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:text="@string/CONFIRMATION_REQUIRED"
        android:textColor="@color/settings_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gameplay_confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_gameplay_menu_row"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:text="@string/FORCE_CLOSE_CONFIRMATION"
        android:textColor="@color/settings_title"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/gameplay_confirm_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gameplay_menu_row"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/action_settings"
            android:textColor="@color/settings_toolbar_end"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gameplay_confirm_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_gameplay_menu_row"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@android:string/cancel"
            android:textColor="@color/settings_toolbar_end"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gameplay_confirm_ok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_gameplay_menu_row"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@android:string/ok"
            android:textColor="@color/settings_toolbar_end"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
