<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_classics_game_background">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/settings_screen_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_toolbar"
            android:elevation="0dp"
            android:minHeight="64dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:navigationIcon="@drawable/ic_arrow_back_black_24dp"
            app:navigationIconTint="@android:color/white"
            app:title="@string/action_settings"
            app:titleCentered="false"
            app:titleTextColor="@android:color/white" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/settings_container"
            android:name="ru.playsoftware.j2meloader.settings.SettingsFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_settings_panel"
            android:clipToPadding="false"
            android:padding="6dp"
            android:tag=".SettingsFragment" />
    </LinearLayout>
</FrameLayout>
