<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_classics_menu_background"
    tools:context="ru.playsoftware.j2meloader.applist.AppsListFragment">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#22000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="15"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="@string/classics_brand"
                android:textAllCaps="true"
                android:textColor="#163A75"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:text="@string/classics_title"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="40sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="43">

            <FrameLayout
                android:id="@+id/carousel_box"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="54dp"
                android:layout_marginEnd="54dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@android:id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:layout_gravity="center"
                    android:overScrollMode="never"
                    android:paddingHorizontal="0dp"
                    tools:itemCount="5"
                    tools:listitem="@layout/list_row_carousel_jar" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/button_previous"
                android:layout_width="40dp"
                android:layout_height="80dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="6dp"
                android:background="@null"
                android:contentDescription="@string/classics_previous"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/bg_launcher_arrow_prev"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/button_next"
                android:layout_width="40dp"
                android:layout_height="80dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@null"
                android:contentDescription="@string/classics_next"
                android:padding="0dp"
                android:scaleType="fitCenter"
                android:src="@drawable/bg_launcher_arrow_next"
                app:tint="@android:color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="13"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/selected_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="44dp"
                android:textColor="@android:color/white"
                android:textSize="25sp"
                tools:text="Abracadaball" />

            <TextView
                android:id="@+id/selected_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#DDF0FF"
                android:textSize="14sp"
                tools:text="Gameloft • 1.0.0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/position_badge"
                android:layout_width="72dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_launcher_position_badge"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                tools:text="1/30" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="30"
                android:progressDrawable="@drawable/bg_launcher_progress" />
        </LinearLayout>

        <Button
            android:id="@+id/button_play"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="6"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_launcher_play_button"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:text="@string/classics_play"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="24sp" />

        <TextView
            android:id="@android:id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/loading_info"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            tools:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_more_games"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_launcher_secondary_button"
                android:fontFamily="sans-serif-medium"
                android:text="@string/classics_more_games"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/button_settings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_launcher_icon_button"
                android:contentDescription="@string/action_settings"
                android:padding="10dp"
                android:src="@drawable/ic_setting_default"
                app:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
