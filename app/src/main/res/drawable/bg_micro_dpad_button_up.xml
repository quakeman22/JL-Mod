<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- recessed shadow base -->
            <item android:top="3dp" android:left="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#12101E" />
                    <corners
                        android:topLeftRadius="20dp"
                        android:topRightRadius="20dp"
                        android:bottomLeftRadius="14dp"
                        android:bottomRightRadius="14dp" />
                </shape>
            </item>
            <!-- sunken face when pressed -->
            <item android:top="7dp" android:left="4dp" android:right="4dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#3A3A42" android:endColor="#232228" />
                    <corners
                        android:topLeftRadius="20dp"
                        android:topRightRadius="20dp"
                        android:bottomLeftRadius="14dp"
                        android:bottomRightRadius="14dp" />
                    <stroke android:width="1dp" android:color="#5B4E70" />
                </shape>
            </item>
            <!-- arrow, nudged down slightly to feel pressed-in -->
            <item android:top="18dp" android:left="19dp" android:right="19dp" android:bottom="26dp">
                <rotate
                    android:drawable="@drawable/ic_dpad_arrow"
                    android:fromDegrees="0"
                    android:pivotX="50%"
                    android:pivotY="50%" />
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- outer bezel / drop shadow -->
            <item android:top="2dp" android:left="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1B1730" />
                    <corners
                        android:topLeftRadius="20dp"
                        android:topRightRadius="20dp"
                        android:bottomLeftRadius="14dp"
                        android:bottomRightRadius="14dp" />
                </shape>
            </item>
            <!-- raised metallic face -->
            <item android:bottom="6dp" android:left="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#6E6E78" android:endColor="#37373D" />
                    <corners
                        android:topLeftRadius="20dp"
                        android:topRightRadius="20dp"
                        android:bottomLeftRadius="14dp"
                        android:bottomRightRadius="14dp" />
                    <stroke android:width="1dp" android:color="#65567C" />
                </shape>
            </item>
            <!-- glossy top highlight -->
            <item android:top="6dp" android:left="9dp" android:right="9dp" android:bottom="42dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#59FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- arrow -->
            <item android:top="15dp" android:left="19dp" android:right="19dp" android:bottom="29dp">
                <rotate
                    android:drawable="@drawable/ic_dpad_arrow"
                    android:fromDegrees="0"
                    android:pivotX="50%"
                    android:pivotY="50%" />
            </item>
        </layer-list>
    </item>
</selector>
