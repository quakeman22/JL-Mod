<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft outer glow / recess so the cross reads as one carved housing -->
    <item android:left="6dp" android:top="14dp" android:right="6dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#241E3A" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="14dp" android:top="6dp" android:right="14dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#241E3A" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- inner recessed well, slightly darker than the petals so they look mounted on it -->
    <item android:left="9dp" android:top="18dp" android:right="9dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#171226" android:endColor="#1F1935" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="18dp" android:top="9dp" android:right="18dp" android:bottom="9dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#171226" android:endColor="#1F1935" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
