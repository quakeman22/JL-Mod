<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#AA8531"
                        android:startColor="#F6E2A1" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#5F4A1A" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#B18D3A"
                        android:startColor="#F4E1A5" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#65501C" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="8dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#D6C06F"
                        android:startColor="#FFF8D8" />
                    <stroke
                        android:width="1dp"
                        android:color="#857140" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
