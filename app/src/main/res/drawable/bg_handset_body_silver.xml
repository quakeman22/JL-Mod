<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:endColor="#8D96A1"
                android:startColor="#EFF2F6" />
            <stroke
                android:width="1dp"
                android:color="#FBFCFE" />
        </shape>
    </item>
    <item android:left="10dp" android:right="10dp" android:top="8dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="90"
                android:endColor="#707985"
                android:startColor="#F6F8FA" />
        </shape>
    </item>
</layer-list>
