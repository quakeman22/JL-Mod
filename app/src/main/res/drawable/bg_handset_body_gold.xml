<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:endColor="#B59545"
                android:startColor="#F3E2A4" />
            <stroke
                android:width="1dp"
                android:color="#FFF2C4" />
        </shape>
    </item>
    <item android:left="10dp" android:right="10dp" android:top="8dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="90"
                android:endColor="#A27E33"
                android:startColor="#F9E9B6" />
        </shape>
    </item>
</layer-list>
