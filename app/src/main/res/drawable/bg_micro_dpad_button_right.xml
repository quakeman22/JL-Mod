<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#171327" />
                    <corners
                        android:topLeftRadius="18dp"
                        android:topRightRadius="22dp"
                        android:bottomLeftRadius="18dp"
                        android:bottomRightRadius="22dp" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:endColor="#2F2F2F" android:startColor="#505050" />
                    <corners
                        android:topLeftRadius="18dp"
                        android:topRightRadius="22dp"
                        android:bottomLeftRadius="18dp"
                        android:bottomRightRadius="22dp" />
                    <stroke android:width="1dp" android:color="#463E56" />
                </shape>
            </item>
            <item android:bottom="16dp" android:left="20dp" android:right="28dp" android:top="16dp">
                <shape android:shape="rectangle">
                    <solid android:color="#F2F2F2" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="7dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1F1931" />
                    <corners
                        android:topLeftRadius="18dp"
                        android:topRightRadius="22dp"
                        android:bottomLeftRadius="18dp"
                        android:bottomRightRadius="22dp" />
                </shape>
            </item>
            <item android:bottom="7dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:endColor="#333333" android:startColor="#585858" />
                    <corners
                        android:topLeftRadius="18dp"
                        android:topRightRadius="22dp"
                        android:bottomLeftRadius="18dp"
                        android:bottomRightRadius="22dp" />
                    <stroke android:width="1dp" android:color="#4C445C" />
                </shape>
            </item>
            <item android:bottom="16dp" android:left="20dp" android:right="28dp" android:top="16dp">
                <shape android:shape="rectangle">
                    <solid android:color="#F2F2F2" />
                    <corners android:radius="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
