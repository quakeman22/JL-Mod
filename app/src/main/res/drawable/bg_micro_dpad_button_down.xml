<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:bottom="3dp" android:left="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#12101E" />
                    <corners
                        android:topLeftRadius="14dp"
                        android:topRightRadius="14dp"
                        android:bottomLeftRadius="20dp"
                        android:bottomRightRadius="20dp" />
                </shape>
            </item>
            <item android:bottom="7dp" android:left="4dp" android:right="4dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#3A3A42" android:endColor="#232228" />
                    <corners
                        android:topLeftRadius="14dp"
                        android:topRightRadius="14dp"
                        android:bottomLeftRadius="20dp"
                        android:bottomRightRadius="20dp" />
                    <stroke android:width="1dp" android:color="#5B4E70" />
                </shape>
            </item>
            <item android:bottom="18dp" android:left="19dp" android:right="19dp" android:top="26dp">
                <rotate
                    android:drawable="@drawable/ic_dpad_arrow"
                    android:fromDegrees="180"
                    android:pivotX="50%"
                    android:pivotY="50%" />
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:bottom="2dp" android:left="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1B1730" />
                    <corners
                        android:topLeftRadius="14dp"
                        android:topRightRadius="14dp"
                        android:bottomLeftRadius="20dp"
                        android:bottomRightRadius="20dp" />
                </shape>
            </item>
            <item android:top="6dp" android:left="4dp" android:right="4dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#6E6E78" android:endColor="#37373D" />
                    <corners
                        android:topLeftRadius="14dp"
                        android:topRightRadius="14dp"
                        android:bottomLeftRadius="20dp"
                        android:bottomRightRadius="20dp" />
                    <stroke android:width="1dp" android:color="#65567C" />
                </shape>
            </item>
            <item android:top="6dp" android:left="9dp" android:right="9dp" android:bottom="42dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#33FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="15dp" android:left="19dp" android:right="19dp" android:top="29dp">
                <rotate
                    android:drawable="@drawable/ic_dpad_arrow"
                    android:fromDegrees="180"
                    android:pivotX="50%"
                    android:pivotY="50%" />
            </item>
        </layer-list>
    </item>
</selector>
