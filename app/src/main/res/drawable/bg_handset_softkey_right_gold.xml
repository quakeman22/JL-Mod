<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#B08934"
                        android:startColor="#FFF1BA" />
                    <stroke
                        android:width="1dp"
                        android:color="#886A29" />
                </shape>
            </item>
            <item android:left="10dp" android:right="10dp" android:top="10dp" android:bottom="10dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#8E1F1B"
                        android:startColor="#D13F36" />
                    <stroke
                        android:width="1dp"
                        android:color="#421212" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#B69142"
                        android:startColor="#F6E5A7" />
                    <stroke
                        android:width="1dp"
                        android:color="#947332" />
                </shape>
            </item>
            <item android:left="10dp" android:right="10dp" android:top="9dp" android:bottom="12dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#8B211C"
                        android:startColor="#D34238" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#451111" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
