<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#7D838D"
                        android:startColor="#E4E8ED" />
                    <stroke
                        android:width="1dp"
                        android:color="#4E545E" />
                </shape>
            </item>
            <item android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#101215" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#AAB1BA"
                        android:startColor="#F0F3F6" />
                    <stroke
                        android:width="1dp"
                        android:color="#6B727C" />
                </shape>
            </item>
            <item android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="9dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#111418"
                        android:startColor="#1D2228" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
