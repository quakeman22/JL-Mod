<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#203A7D"
                        android:startColor="#B8CEFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#123062" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#2750A0"
                        android:startColor="#DDE8FF" />
                    <stroke
                        android:width="1dp"
                        android:color="#27467F" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="8dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#162750"
                        android:startColor="#7D9DE8" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
