<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#132554"
                        android:startColor="#96B8FF" />
                    <stroke
                        android:width="1dp"
                        android:color="#0B1734" />
                </shape>
            </item>
            <item android:left="10dp" android:right="10dp" android:top="10dp" android:bottom="10dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <solid android:color="#6CF05D" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="90"
                        android:endColor="#1B3470"
                        android:startColor="#D3E3FF" />
                    <stroke
                        android:width="1dp"
                        android:color="#14284F" />
                </shape>
            </item>
            <item android:left="10dp" android:right="10dp" android:top="9dp" android:bottom="12dp">
                <shape android:shape="rectangle">
                    <corners android:radius="7dp" />
                    <stroke
                        android:width="2dp"
                        android:color="#49DC4D" />
                    <solid android:color="#10141414" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
